<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" fx:id="content" prefHeight="500.0" prefWidth="900.0" style="-fx-border-color: #343434; -fx-border-width: 2;" stylesheets="@../css/appStyle.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UpdateAllFromExcleController">
