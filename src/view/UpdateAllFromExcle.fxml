                  </ImageView>
               </graphic>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
         <styleClass>
            <String fx:value="background" />
            <String fx:value="shadowStyle" />
         </styleClass>
      </HBox>
      <StackPane fx:id="stackPane" layoutY="5.0" nodeOrientation="RIGHT_TO_LEFT" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="70.0">
         <children>
            <VBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="200.0" prefWidth="100.0">
               <children>
