                  </HBox>
                  <ScrollPane fitToHeight="true" fitToWidth="true" prefWidth="3000.0" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="vbox" alignment="CENTER">
                           <children>
                              <ListView fx:id="showArea" prefHeight="372.0" prefWidth="1188.0" styleClass="shadowStyle" VBox.vgrow="ALWAYS" />
