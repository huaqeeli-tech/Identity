CREATE TABLE `documentfiles` (
  `ID` int(11) NOT NULL AUTO_INCREMENT,
  `MILITARYID` varchar(45) DEFAULT NULL,
  `DOCUMENTTOPIC` varchar(200) DEFAULT NULL,
  `DOCUMENTTYPE` varchar(200) DEFAULT NULL,
  `DOCUMENTIMAGE` longblob,
  PRIMARY KEY (`ID`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8;

CREATE TABLE `personaldata` (
  `MILITARYID` int(11) NOT NULL,
  `IDNUMBER` varchar(45) DEFAULT NULL,
  `NAME` varchar(300) DEFAULT NULL,
  `RANK` varchar(45) DEFAULT NULL,
  `PHONNUMBER` varchar(45) DEFAULT NULL,
  `SPECIALTY` varchar(300) DEFAULT NULL,
  `NOTE` varchar(500) DEFAULT NULL,
  `PERSONALIMAGE` longblob,
  PRIMARY KEY (`MILITARYID`),
  KEY `MILITARYID` (`MILITARYID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

CREATE TABLE `userdata` (
  `ID` int(11) NOT NULL AUTO_INCREMENT,
  `MILITARYID` varchar(45) CHARACTER SET utf8 COLLATE utf8_bin DEFAULT NULL,
  `USERTYPE` varchar(45) CHARACTER SET utf8 COLLATE utf8_bin DEFAULT NULL,
  `USERNAME` varchar(45) CHARACTER SET utf8 COLLATE utf8_bin DEFAULT NULL,
  `PASSWORD` varchar(45) CHARACTER SET utf8 COLLATE utf8_bin DEFAULT NULL,
  `PASSWORDSTATE` varchar(45) CHARACTER SET utf8 COLLATE utf8_bin DEFAULT NULL,
  PRIMARY KEY (`ID`)
) ENGINE=InnoDB AUTO_INCREMENT=19 DEFAULT CHARSET=utf8 COLLATE=utf8_bin;

CREATE TABLE `personalimages` (
  `ID` int(11) NOT NULL AUTO_INCREMENT,
  `MILITARYID` varchar(45) DEFAULT NULL,
  `DOCUMENTNAME` varchar(200) DEFAULT NULL,
  `DOCUMENTTYPE` varchar(200) DEFAULT NULL,
  `EXPIRATIONDATE` varchar(45) DEFAULT NULL,
  `DOCUMENTIMAGE` longblob,
  PRIMARY KEY (`ID`)
) ENGINE=InnoDB AUTO_INCREMENT=17 DEFAULT CHARSET=utf8;

CREATE DATABASE `identity` /*!40100 DEFAULT CHARACTER SET utf8 */;


